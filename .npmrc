auto-install-peers=false
strict-peer-dependencies=false

# The npm registry connection drops mid-download on some networks, which fails
# the Docker build at `pnpm install`. Retry harder and wait longer rather than
# giving up on the first dropped socket.
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
network-concurrency=4
