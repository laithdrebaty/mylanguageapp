# ─── Database ────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/ascension

# Connection pool tuning (optional — see lib/db/src/index.ts for docs)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ─── Session ──────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 64
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# CORS: set to your deployed frontend URL in production, e.g. https://lughati.app
# Leave unset in development to allow all origins.
ALLOWED_ORIGIN=

# Reverse proxy hops between client and Express (1 for Replit/Cloudflare)
TRUST_PROXY=1

# ─── Logging ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── AI provider (V1: leave unset or set to "stub") ───────────────────────────
# When you add a provider: set AI_PROVIDER=openai and AI_API_KEY=sk-...
AI_PROVIDER=stub
AI_API_KEY=

# ─── Cache backend (V1: in-process memory, no external dependency) ────────────
# When scaling out: set CACHE_PROVIDER=redis and REDIS_URL=redis://...
CACHE_PROVIDER=memory
REDIS_URL=

# ─── Background jobs (V1: in-process fire-and-forget) ─────────────────────────
# When scaling out: set JOB_QUEUE=bullmq and REDIS_URL=redis://...
JOB_QUEUE=memory
