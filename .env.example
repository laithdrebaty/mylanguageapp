# ─── Database ─────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/ascension

# Connection pool tuning (see lib/db/src/index.ts for docs)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ─── Session ──────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 64
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# CORS: set to your deployed frontend URL in production (e.g. https://lughati.app).
# Leave unset in development to allow all origins.
ALLOWED_ORIGIN=

# Reverse proxy hops between client and Express (1 behind nginx/Cloudflare)
TRUST_PROXY=1

# ─── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Redis ────────────────────────────────────────────────────────────────────
# Leave unset to run without Redis (in-process cache; single-server only).
# Set for multi-instance deployments, shared rate limiting, and AI quota enforcement.
#
# Supported URL formats:
#   redis://[:password@]host:6379[/db]
#   rediss://[:password@]host:6380[/db]   ← TLS (recommended for production)
#
# Recommended Redis settings (in redis.conf or cloud provider dashboard):
#   maxmemory 256mb
#   maxmemory-policy allkeys-lru   ← evict LRU keys when memory is full
REDIS_URL=

# Redis client timeouts (milliseconds)
REDIS_CONNECT_TIMEOUT=3000
REDIS_CMD_TIMEOUT=1000

# ─── Rate limiting ─────────────────────────────────────────────────────────────
# When Redis is configured, rate limit counters are shared across all instances.
# When Redis is absent, counters are per-instance (fine for single-server dev).
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_API=200             # general API (all /api routes)
RATE_LIMIT_AUTH=10             # auth endpoints (login, register) — failed attempts only

# ─── AI provider ──────────────────────────────────────────────────────────────
# V1: leave unset or stub. Set to 'openai' (or future providers) when implementing.
AI_PROVIDER=stub
AI_API_KEY=

# Per-subscription daily AI request limits
AI_DAILY_LIMIT_GENERAL=5       # general_english plan
AI_DAILY_LIMIT_PRO=20          # professional_english plan

# ─── Background jobs ──────────────────────────────────────────────────────────
# V1: in-process fire-and-forget. Set to 'bullmq' when scaling out.
# BullMQ uses REDIS_URL above for its queue backend.
JOB_QUEUE=memory
